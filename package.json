{
  "name": "loreworks",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild scripts/account_admin.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/account-admin.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "validate:data": "node scripts/validate_data.mjs",
    "validate:source": "node scripts/check_source_integrity.mjs",
    "validate:deploy": "node scripts/check_deployment.mjs",
    "validate:github": "node scripts/test_github_narrative.mjs",
    "validate": "npm run validate:data && npm run validate:canon && npm run validate:source && npm run validate:github && npm run validate:index && npm run validate:deploy && npm run validate:stack && npm run validate:assets && npm run validate:application && npm run validate:chain && npm run validate:wallet && npm run validate:delivery && npm run validate:codex && npm run validate:corpus && npm run validate:independence",
    "validate:index": "tsx scripts/test_lore_index.ts",
    "validate:canon": "node scripts/check_canonical_segmentation.mjs",
    "validate:stack": "node scripts/check_full_stack.mjs",
    "validate:assets": "node --import tsx --test scripts/test_assets.ts",
    "prebuild": "node scripts/sync_public_assets.mjs",
    "validate:application": "node --import tsx --test scripts/test_application.ts",
    "account:admin": "node dist/account-admin.cjs",
    "validate:chain": "node --import tsx --test scripts/test_chain_snapshot.ts",
    "validate:wallet": "node --import tsx --test scripts/test_wallet_client.ts",
    "validate:delivery": "node --import tsx --test scripts/test_source_delivery.ts scripts/test_expeditions.ts",
    "validate:codex": "node --import tsx --test scripts/test_admin.ts scripts/test_registry_taxonomy.ts scripts/test_character.ts",
    "validate:corpus": "node --import tsx --test scripts/test_lore_corpus.ts scripts/test_owner_wallet.ts scripts/test_reader13.ts",
    "validate:independence": "node scripts/check_google_independence.mjs",
    "build:pages": "node scripts/build_pages.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@wharfkit/antelope": "1.1.1",
    "@wharfkit/session": "1.6.1",
    "@wharfkit/signing-request": "3.4.0",
    "@wharfkit/wallet-plugin-anchor": "1.6.1",
    "@wharfkit/wallet-plugin-cloudwallet": "1.6.2",
    "@wharfkit/web-renderer": "1.4.3",
    "buffer": "^6.0.3",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "4.0.1",
    "sql.js": "^1.14.2",
    "vite": "^6.2.0",
    "vite-plugin-node-polyfills": "^0.25.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/sql.js": "^1.4.11",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
